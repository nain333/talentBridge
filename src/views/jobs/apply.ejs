<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h2 class="fw-bold mb-1">
                                Apply For Job
                            </h2>

                            <p class="text-muted mb-0">
                                <%= job.jobdesignation %> at <%= job.companyname %>
                            </p>

                        </div>

                        <a
                            href="/jobs/<%= job.id %>"
                            class="btn btn-outline-secondary"
                        >
                            Back
                        </a>

                    </div>

                    <% if (errors && errors.length > 0) { %>

                        <% errors.forEach(error => { %>

                            <div class="alert alert-danger">
                                <%= error.msg %>
                            </div>

                        <% }) %>

                    <% } %>

                    <hr class="mb-4">

                    <form
                        action="/apply/<%= job.id %>"
                        method="POST"
                        enctype="multipart/form-data"
                    >

                        <div class="mb-3">

                            <label
                                for="name"
                                class="form-label"
                            >
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="mb-3">

                            <label
                                for="email"
                                class="form-label"
                            >
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="mb-3">

                            <label
                                for="contact"
                                class="form-label"
                            >
                                Contact Number
                            </label>

                            <input
                                type="tel"
                                id="contact"
                                name="contact"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="mb-4">

                            <label
                                for="resume"
                                class="form-label"
                            >
                                Resume
                            </label>

                            <input
                                type="file"
                                id="resume"
                                name="resume"
                                class="form-control"
                                accept=".pdf,.doc,.docx"
                                required
                            >

                            <div class="form-text">
                                Accepted formats: PDF, DOC, DOCX
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a
                                href="/jobs/<%= job.id %>"
                                class="btn btn-outline-secondary"
                            >
                                Cancel
                            </a>

                            <button
                                type="submit"
                                class="btn btn-success"
                            >
                                Submit Application
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>