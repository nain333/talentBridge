<div class="container py-5">

    <div class="card shadow border-0">

        <div class="card-body p-5">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                <div>
                    <h1 class="fw-bold mb-1">
                        <%= job.jobdesignation %>
                    </h1>

                    <h5 class="mb-2">
                        <%= job.companyname %>
                    </h5>

                    <span class="badge bg-primary">
                        <%= job.jobcategory %>
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <a href="/jobs" class="btn btn-outline-secondary">
                        Back
                    </a>

                    <% if (isAuthenticated) { %>

                        <a href="/jobs/<%= job.id %>/edit" class="btn btn-warning">
                            Edit
                        </a>

                        <form action="/jobs/<%= job.id %>/delete" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Are you sure you want to delete this job?')">
                                Delete
                            </button>
                        </form>

                        <% } else { %>

                            <a href="/jobs/<%= job.id %>/apply" class="btn btn-success">
                                Apply Now
                            </a>

                            <% } %>

                </div>

            </div>

            <hr>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Location
                        </h6>

                        <p class="mb-0">
                            <%= job.joblocation %>
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Salary
                        </h6>

                        <p class="mb-0">
                            <%= job.salary %>
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Apply Before
                        </h6>

                        <p class="mb-0">
                            <%= job.applyby %>
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Open Positions
                        </h6>

                        <p class="mb-0">
                            <%= job.numberofopenings %>
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Posted On
                        </h6>

                        <p class="mb-0">
                            <%= new Date(job.jobposted).toLocaleDateString() %>
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="text-muted mb-2">
                            Total Applicants
                        </h6>

                        <p class="mb-0">
                            <%= job.applicants.length %>
                        </p>
                    </div>
                </div>

            </div>

            <div class="mt-4">

                <h5 class="mb-3">
                    Skills Required
                </h5>

                <% if (Array.isArray(job.skillsrequired)) { %>

                    <div class="d-flex flex-wrap gap-2">

                        <% job.skillsrequired.forEach(skill=> { %>

                            <span class="badge bg-primary fs-6">
                                <%= skill %>
                            </span>

                            <% }) %>

                    </div>

                    <% } else { %>

                        <p>
                            <%= job.skillsrequired %>
                        </p>

                        <% } %>

            </div>

        </div>

    </div>

</div>